# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Kapso (WhatsApp Cloud API proxy)
KAPSO_API_KEY=
KAPSO_BASE_URL=https://app.kapso.ai/api/meta/
WHATSAPP_PHONE_NUMBER_ID=
WABA_ID=

# Webhook security
# Meta app secret (X-Hub-Signature-256). Leave blank only in the sandbox.
META_APP_SECRET=
# Token used for the GET verification handshake
WEBHOOK_VERIFY_TOKEN=change-me

# Links the agent sends
JOB_BOARD_URL=https://marketplace.siteworker.com
SECURE_UPLOAD_URL=https://marketplace.siteworker.com/profile/documents
DOWE_URL=https://dowe.us

# Published Flow IDs (fill after npm run deploy:flows)
FLOW_ID_AVAILABILITY_EN=
FLOW_ID_AVAILABILITY_ES=
FLOW_ID_CREW_REQUEST=

# Escalation alerts: urgent -> text (Twilio), everything else -> email (SendGrid)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
ESCALATION_EMAIL_FROM=
# Who gets alerts until each worker's specialist is wired in (comma-separated)
ESCALATION_SMS_TO=
ESCALATION_EMAIL_TO=
# Defaults to DRY_RUN; set false to send real texts/emails while WhatsApp stays in dry run
ALERTS_DRY_RUN=

# Runtime
PORT=3000
# DRY_RUN=true prints outbound messages instead of sending them
DRY_RUN=true
AUDIT_LOG_PATH=./data/audit.jsonl
TIMEZONE=America/New_York
